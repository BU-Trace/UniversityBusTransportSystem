#!/bin/sh
# husky pre-push hook

echo "🔍 Checking for build errors before push..."

# Run server build
npm --prefix server run build
if [ $? -ne 0 ]; then
  echo "❌ Server build failed. Push aborted."
  exit 1
fi

# Run client build
npm --prefix client run build
if [ $? -ne 0 ]; then
  echo "❌ Client build failed. Push aborted."
  exit 1
fi

echo "✅ Build succeeded. Proceeding with push."
